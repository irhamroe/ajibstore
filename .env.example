# Port Server (Default: 3000 atau 10000 di Render)
PORT=3000

# Connection String Neon PostgreSQL Cloud Database
# Dapatkan URL ini dari dashboard Neon Anda (https://neon.tech)
# Format: postgresql://[user]:[password]@[ep-host].neon.tech/[dbname]?sslmode=require
# Jika DATABASE_URL dikosongkan/di-comment, server otomatis menggunakan SQLite lokal (ajibstore.db)
DATABASE_URL=postgresql://neondb_owner:npg_xxxxxx@ep-cool-cloud-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
